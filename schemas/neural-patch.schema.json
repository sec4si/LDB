{
  "$defs": {
    "EvidenceLevel": {
      "enum": [
        "observed",
        "correlated",
        "attributed",
        "causally_tested",
        "replicated"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "Intervention": {
      "additionalProperties": false,
      "properties": {
        "dictionary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dictionary"
        },
        "expert": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expert"
        },
        "feature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature"
        },
        "head": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Head"
        },
        "hook": {
          "title": "Hook",
          "type": "string"
        },
        "num_heads": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Heads"
        },
        "operation": {
          "$ref": "#/$defs/InterventionKind"
        },
        "request_scoped": {
          "default": true,
          "title": "Request Scoped",
          "type": "boolean"
        },
        "tensor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tensor"
        },
        "token": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "hook",
        "operation"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "InterventionKind": {
      "enum": [
        "scale",
        "ablate",
        "replace",
        "add",
        "routing_bias",
        "head_ablate",
        "feature_scale"
      ],
      "title": "InterventionKind",
      "type": "string"
    },
    "ValidationSummary": {
      "additionalProperties": false,
      "properties": {
        "related_generalization": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Generalization"
        },
        "target_success": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Target Success",
          "type": "number"
        },
        "unrelated_regression": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unrelated Regression"
        }
      },
      "required": [
        "target_success"
      ],
      "title": "ValidationSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "title": "Adapter",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceLevel",
      "default": "observed"
    },
    "hook_schema_version": {
      "default": "ldb.hooks/v1alpha1",
      "title": "Hook Schema Version",
      "type": "string"
    },
    "interventions": {
      "items": {
        "$ref": "#/$defs/Intervention"
      },
      "minItems": 1,
      "title": "Interventions",
      "type": "array"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_revision": {
      "title": "Model Revision",
      "type": "string"
    },
    "patch_id": {
      "title": "Patch Id",
      "type": "string"
    },
    "schema_version": {
      "const": "ldb.patch/v1alpha1",
      "default": "ldb.patch/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "tokenizer_hash": {
      "title": "Tokenizer Hash",
      "type": "string"
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "patch_id",
    "description",
    "model_id",
    "model_revision",
    "tokenizer_hash",
    "adapter",
    "interventions"
  ],
  "title": "NeuralPatch",
  "type": "object"
}
