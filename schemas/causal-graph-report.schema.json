{
  "$defs": {
    "CausalEdge": {
      "additionalProperties": false,
      "properties": {
        "activation_recovery": {
          "title": "Activation Recovery",
          "type": "number"
        },
        "mediated_effect": {
          "title": "Mediated Effect",
          "type": "number"
        },
        "mediated_log_probability": {
          "title": "Mediated Log Probability",
          "type": "number"
        },
        "mediated_recovery": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mediated Recovery"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "activation_recovery",
        "mediated_log_probability",
        "mediated_effect"
      ],
      "title": "CausalEdge",
      "type": "object"
    },
    "CausalTrial": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "title": "Effect",
          "type": "number"
        },
        "hook": {
          "title": "Hook",
          "type": "string"
        },
        "patched_log_probability": {
          "title": "Patched Log Probability",
          "type": "number"
        },
        "recovery": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recovery"
        }
      },
      "required": [
        "hook",
        "patched_log_probability",
        "effect"
      ],
      "title": "CausalTrial",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "backend": {
      "title": "Backend",
      "type": "string"
    },
    "backend_version": {
      "title": "Backend Version",
      "type": "string"
    },
    "clean_log_probability": {
      "title": "Clean Log Probability",
      "type": "number"
    },
    "clean_prompt": {
      "title": "Clean Prompt",
      "type": "string"
    },
    "corrupt_log_probability": {
      "title": "Corrupt Log Probability",
      "type": "number"
    },
    "corrupt_prompt": {
      "title": "Corrupt Prompt",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/CausalEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "hook_schema_version": {
      "default": "ldb.hooks/v1alpha1",
      "title": "Hook Schema Version",
      "type": "string"
    },
    "max_path_trials": {
      "exclusiveMinimum": 0,
      "title": "Max Path Trials",
      "type": "integer"
    },
    "minimum_recovery": {
      "title": "Minimum Recovery",
      "type": "number"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/CausalTrial"
      },
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "default": "ldb.causal-graph/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_token_id": {
      "minimum": 0,
      "title": "Target Token Id",
      "type": "integer"
    },
    "token_index": {
      "default": -1,
      "title": "Token Index",
      "type": "integer"
    },
    "tokenizer_hash": {
      "title": "Tokenizer Hash",
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "backend",
    "backend_version",
    "tokenizer_hash",
    "clean_prompt",
    "corrupt_prompt",
    "target_token_id",
    "minimum_recovery",
    "max_path_trials",
    "clean_log_probability",
    "corrupt_log_probability",
    "nodes",
    "edges"
  ],
  "title": "CausalGraphReport",
  "type": "object"
}
